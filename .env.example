# Copy to .env (git-ignored). Defaults match `prox up` + `docker compose up -d`.

# --- App ---------------------------------------------------------------
APP_ENV=development                 # development | production
BIND_ADDR=0.0.0.0:8106
RUST_LOG=info,parcel_server=debug
LOG_FORMAT=text                     # text | json (default json in production)
DATABASE_URL=postgres://postgres:localdev@localhost:5439/parcel

# --- Origins -----------------------------------------------------------
# The app (SPA + API) and the sandboxed user-content origin. They MUST differ.
PARCEL_APP_ORIGIN=https://parcel.local.stridelabs.ai
PARCEL_CONTENT_ORIGIN=https://parcelcontent.local.stridelabs.ai
# HMAC key for content links (>= 32 chars; required in production).
PARCEL_CONTENT_SIGNING_KEY=local-dev-signing-key-change-me-0123456789
PARCEL_CONTENT_TOKEN_TTL_SECS=43200

# --- Auth --------------------------------------------------------------
# AUTH_MODE=dev is a local-only bypass (a fixed user); refused in production.
AUTH_MODE=slauth                    # slauth | dev
DEV_AUTH_EMAIL=dev@example.com
DEV_AUTH_NAME="Dev User"
SLAUTH_ISSUER=https://auth.local.stridelabs.ai
SLAUTH_JWKS_URL=https://auth.local.stridelabs.ai/.well-known/jwks.json
SLAUTH_AUDIENCE=parcel
SLAUTH_CLIENT_ID=parcel

# --- Blob storage ------------------------------------------------------
BLOB_BACKEND=fs                     # fs | gcs | memory
BLOB_FS_ROOT=./data/blobs
# For the GCS emulator (docker compose's fake-gcs):
# BLOB_BACKEND=gcs
# GCS_BUCKET=parcel-dev
# STORAGE_EMULATOR_HOST=http://localhost:4447
# Production uses the Cloud Run service account via the metadata server;
# GOOGLE_CREDENTIALS (base64 service-account JSON) is the alternative.
BLOB_CACHE_MAX_BYTES=134217728

# --- Limits (bytes / counts) ---------------------------------------------
PARCEL_MAX_ENTRY_BYTES=16777216
PARCEL_MAX_FILE_BYTES=15728640
PARCEL_MAX_UPLOAD_BYTES=67108864
PARCEL_MAX_FILES_PER_UPLOAD=256
PARCEL_MAX_FILES_PER_VERSION=512
PARCEL_MAX_VERSION_BYTES=268435456
PARCEL_USER_QUOTA_BYTES=2147483648  # 0 = unlimited
PARCEL_MAX_CONCURRENT_UPLOADS=8

# --- Production-only ---------------------------------------------------
# PARCEL_STATIC_DIR=/app/static     # serve the built SPA from this directory
# PARCEL_GC_INTERVAL_SECS=3600
# PARCEL_GC_GRACE_SECS=3600
