# Copy to .env (git-ignored). Defaults match `prox up` + `docker compose up -d`.

# --- App ---------------------------------------------------------------
APP_ENV=development                 # development | production
BIND_ADDR=0.0.0.0:8106
RUST_LOG=info,parcel_server=debug
LOG_FORMAT=text                     # text | json | cloud (default json in production)
DATABASE_URL=postgres://postgres:localdev@localhost:5439/parcel

# --- Origins -----------------------------------------------------------
# The app (SPA + API) and the sandboxed user-content origin. They MUST differ.
PARCEL_APP_ORIGIN=https://parcel.local.stridelabs.ai
PARCEL_CONTENT_ORIGIN=https://parcelcontent.local.stridelabs.ai
# HMAC key for content links (>= 32 chars; required in production).
PARCEL_CONTENT_SIGNING_KEY=local-dev-signing-key-change-me-0123456789
PARCEL_CONTENT_TOKEN_TTL_SECS=43200

# --- Auth --------------------------------------------------------------
# People sign in through one or more OIDC providers (server-side; the browser
# gets a signed session cookie). AUTH_MODE=dev is a local-only bypass (a
# fixed user); refused in production.
AUTH_MODE=oidc                      # oidc | dev   (slauth = oidc, the old name)
DEV_AUTH_EMAIL=dev@example.com
DEV_AUTH_NAME="Dev User"

# Unset AUTH_PROVIDERS = one provider, slauth, from these two:
SLAUTH_ISSUER=https://auth.local.stridelabs.ai
SLAUTH_CLIENT_ID=parcel

# Several providers at once (each reads AUTH_<ID>_*; ids are [a-z][a-z0-9]*):
# AUTH_PROVIDERS=slauth,keycloak
# AUTH_KEYCLOAK_ISSUER=http://localhost:4448/realms/parcel   # see dev/keycloak/
# AUTH_KEYCLOAK_CLIENT_ID=parcel
# AUTH_KEYCLOAK_CLIENT_SECRET=parcel-local-keycloak-secret   # omit for a public (PKCE) client
# AUTH_KEYCLOAK_LABEL="EU office (Keycloak)"                 # the sign-in button
# AUTH_KEYCLOAK_ALLOWED_DOMAINS=eu.example.com               # empty = any domain
# AUTH_KEYCLOAK_TRUST_EMAIL=false     # true: accept emails not marked email_verified
# AUTH_KEYCLOAK_PROVIDER_LOGOUT=false # true: signing out of Parcel signs out of the provider
# AUTH_KEYCLOAK_SCOPES="openid email profile"

PARCEL_SESSION_TTL_SECS=604800      # web sessions last 7 days, then ask the provider again
PARCEL_TOKEN_LOGIN_MAX_AGE_DAYS=30  # pcl_ tokens pause after this long without a web sign-in (0 = never)
PARCEL_ALLOW_PUBLIC=true            # false: no public links; "internal" is the widest

# --- MCP server (<app origin>/mcp) --------------------------------------
# Agents (Claude, Claude Code, …) sign in through PARCEL_MCP_PROVIDER, which
# must register this resource (slauth: apps.yaml mcp_resources). Needs
# AUTH_MODE=oidc (boot fails under AUTH_MODE=dev) and an https
# PARCEL_APP_ORIGIN without a port, as under prox.
# PARCEL_MCP_ENABLED=true
# PARCEL_MCP_PROVIDER=slauth          # a configured provider's id
# PARCEL_MCP_JWKS_URL=                # default: <issuer>/.well-known/jwks.json

# --- Blob storage ------------------------------------------------------
BLOB_BACKEND=fs                     # fs | gcs | memory
BLOB_FS_ROOT=./data/blobs
# For the GCS emulator (docker compose's fake-gcs):
# BLOB_BACKEND=gcs
# GCS_BUCKET=parcel-dev
# STORAGE_EMULATOR_HOST=http://localhost:4447
# Production uses the Cloud Run service account via the metadata server;
# GOOGLE_CREDENTIALS (base64 service-account JSON) is the alternative; when
# set it is checked at startup, and the server refuses to start on a bad key
# (blank means unset, as for every variable here).
BLOB_CACHE_MAX_BYTES=134217728

# --- Limits (bytes / counts) ---------------------------------------------
PARCEL_MAX_ENTRY_BYTES=16777216
PARCEL_MAX_FILE_BYTES=15728640
PARCEL_MAX_UPLOAD_BYTES=67108864
PARCEL_MAX_FILES_PER_UPLOAD=256
PARCEL_MAX_FILES_PER_VERSION=512
PARCEL_MAX_VERSION_BYTES=268435456
PARCEL_USER_QUOTA_BYTES=2147483648  # 0 = unlimited
PARCEL_MAX_DATA_BYTES=10485760       # per parcel: JSON data its page/agent keeps
PARCEL_MAX_DATA_VALUE_BYTES=262144   # largest single data value
PARCEL_MAX_CONCURRENT_UPLOADS=8

# --- Production-only ---------------------------------------------------
# RUN_MIGRATIONS=false              # production runs `parcel-server migrate` as a job
# PARCEL_STATIC_DIR=/app/static     # serve the built SPA from this directory
# PARCEL_GC_INTERVAL_SECS=3600
# PARCEL_GC_GRACE_SECS=3600
